# ---------------------------------------------------------------------------
# backend 환경변수 예시. 실제 값은 .env (로컬) 또는 Secret Manager (staging/prod) 에 둔다.
# 이 파일에는 실제 secret 을 절대 적지 않는다. (공통 04 §2, 공통 06 §6)
# ---------------------------------------------------------------------------

# 실행 환경. dev / staging / production 을 분리한다. (공통 02 §2)
NODE_ENV=development
APP_ENV=dev

# 앱인토스 appName.
# frontend/apps-in-toss.config.ts 의 appName 과 반드시 같아야 한다. (하드게이트 P0)
# 이 값에서 CORS allowlist 가 파생된다.
#   https://<APP_NAME>.web.tossmini.com
#   https://<APP_NAME>.private-web.tossmini.com
# ⚠ 현재 값은 작업명 기준 임시값이다. 상표 확인 후 확정하고 콘솔에 등록한다. (09 §4)
APP_NAME=hanguksa5min

HOST=0.0.0.0
PORT=8080
LOG_LEVEL=info

# PostgreSQL. 로컬은 docker compose 로 띄운다. (pnpm db:up)
# 형식: postgres://{POSTGRES_USER}:{POSTGRES_PASSWORD}@127.0.0.1:{POSTGRES_PORT}/{POSTGRES_DB}
# 실제 값은 .env 에만 적는다. 이 파일에는 자리표시자만 둔다.
DATABASE_URL=

# 로컬 개발용 추가 CORS origin (쉼표 구분). production 에서는 무시된다.
ADDITIONAL_CORS_ORIGINS=http://localhost:5173

# ---------------------------------------------------------------------------
# 아래 항목은 1단계(인증) 이후에 추가한다. 지금은 사용하지 않으므로 비워 둔다.
# 값이 정해지면 env.ts 스키마에도 함께 추가한다.
# ---------------------------------------------------------------------------
# anonKey fingerprint 용 HMAC pepper (공통 06 §1)
# SERVER_PEPPER=
# anonKey 원문 암호화 키 / 키 버전 (공통 06 §2, 스마트 발송이 필요할 때만 사용)
# ANON_KEY_ENCRYPTION_KEY=
# ANON_KEY_KEY_VERSION=
# 앱인토스 사용자 식별키 검증 API + mTLS 인증서 (공통 06 §6)
# AIT_USER_KEY_VERIFY_URL=
# AIT_MTLS_CERT_PATH=
# AIT_MTLS_KEY_PATH=
# 내부 access token 서명 키 / TTL (TTL 은 AGENTS.md §9 #3 미결정)
# INTERNAL_TOKEN_SECRET=
# INTERNAL_TOKEN_TTL_SECONDS=
