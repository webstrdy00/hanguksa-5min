# ---------------------------------------------------------------------------
# backend 환경변수 예시. 실제 값은 .env (로컬) 또는 Secret Manager (staging/prod) 에 둔다.
# 이 파일에는 실제 secret 을 절대 적지 않는다. (공통 04 §2, 공통 06 §6)
# ---------------------------------------------------------------------------

# 실행 환경. dev / staging / production 을 분리한다. (공통 02 §2)
NODE_ENV=development
APP_ENV=dev

# 앱인토스 appName.
# frontend/apps-in-toss.config.ts 의 appName 과 반드시 같아야 한다. (하드게이트 P0)
# 이 값에서 CORS allowlist 가 파생된다.
#   https://<APP_NAME>.web.tossmini.com
#   https://<APP_NAME>.private-web.tossmini.com
# ⚠ 콘솔 등록 후에는 바꿀 수 없다. 딥링크·CORS·mTLS 인증서 CN 이 모두 이 값을 따른다. (09 §4)
APP_NAME=hanguksa5min

HOST=0.0.0.0
PORT=8080
LOG_LEVEL=info

# PostgreSQL. 로컬은 docker compose 로 띄운다. (pnpm db:up)
# 형식: postgres://{POSTGRES_USER}:{POSTGRES_PASSWORD}@127.0.0.1:{POSTGRES_PORT}/{POSTGRES_DB}
# 실제 값은 .env 에만 적는다. 이 파일에는 자리표시자만 둔다.
DATABASE_URL=

# 로컬 개발용 추가 CORS origin (쉼표 구분). production 에서는 무시된다.
ADDITIONAL_CORS_ORIGINS=http://localhost:5173

# ---------------------------------------------------------------------------
# 인증 (공통 06 §1~2). 아래는 전부 secret 이다.
# 값은 .env 또는 Secret Manager 에만 두고 코드/DB 에 저장하지 않는다.
# ---------------------------------------------------------------------------

# anonKey fingerprint 생성용 HMAC pepper (32자 이상)
# 생성: node -e "console.log(require('node:crypto').randomBytes(32).toString('base64url'))"
SERVER_PEPPER=
SERVER_PEPPER_VERSION=1
# pepper 회전 시 이전 값을 남긴다. 형식: 버전:시크릿,버전:시크릿
# 기존 사용자가 재접속하면 현재 버전 fingerprint 로 자동 이관된다.
SERVER_PEPPER_PREVIOUS=

# 내부 access token 서명 키 (32자 이상). pepper 와 다른 값을 쓴다.
INTERNAL_TOKEN_SECRET=
# 공통 06 §1 "짧은 수명". 2026-08-15 기준 30분(1800초)으로 확정.
INTERNAL_TOKEN_TTL_SECONDS=1800

# 식별키 검증 경로.
#   toss = 실제 앱인토스 API (mTLS 필수)
#   mock = 개발용 대체 구현. 운영 환경에서 지정하면 서버가 기동하지 않는다.
IDENTITY_PROVIDER=mock
AIT_USER_KEY_VERIFY_URL=https://apps-in-toss-api.toss.im/api-partner/v1/apps-in-toss/users/anon-key/verify
AIT_VERIFY_TIMEOUT_MS=3000

# mTLS 인증서 경로. IDENTITY_PROVIDER=toss 일 때 필수.
# 인증서 파일 자체는 저장소에 넣지 않는다. (공통 06 §6)
AIT_MTLS_CERT_PATH=
AIT_MTLS_KEY_PATH=
