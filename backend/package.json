{
  "name": "@hanguksa/backend",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=24.0.0"
  },
  "scripts": {
    "dev": "node --watch --env-file-if-exists=.env src/index.ts",
    "build": "tsc -p tsconfig.build.json",
    "start": "node dist/index.js",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "node --env-file-if-exists=.env src/db/migrate.ts",
    "test:db": "vitest run --config vitest.db.config.ts",
    "db:seed": "node --env-file-if-exists=.env src/db/seed.ts"
  },
  "dependencies": {
    "@fastify/cors": "11.3.0",
    "@fastify/helmet": "13.1.0",
    "@fastify/rate-limit": "11.2.0",
    "drizzle-orm": "0.45.2",
    "fastify": "5.12.0",
    "jose": "6.2.9",
    "pino": "10.3.1",
    "postgres": "3.4.9",
    "undici": "8.10.0",
    "zod": "4.4.3"
  },
  "devDependencies": {
    "@eslint/js": "9.39.5",
    "@types/node": "24.13.3",
    "drizzle-kit": "0.31.10",
    "eslint": "9.39.5",
    "globals": "16.5.0",
    "pino-pretty": "13.1.3",
    "typescript": "5.9.3",
    "typescript-eslint": "8.67.0",
    "vitest": "4.1.10"
  }
}
