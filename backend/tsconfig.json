{
  "compilerOptions": {
    "target": "ES2023",
    "lib": ["ES2023"],
    "module": "NodeNext",
    "moduleResolution": "NodeNext",
    "types": ["node"],
    "sourceMap": true,
    "declaration": false,

    /* Node 24의 네이티브 타입 스트리핑으로 .ts를 그대로 실행하기 위한 제약 */
    "erasableSyntaxOnly": true,
    "verbatimModuleSyntax": true,
    "allowImportingTsExtensions": true,
    "rewriteRelativeImportExtensions": true,

    /* strict typing (원칙 17) */
    "strict": true,
    "noUncheckedIndexedAccess": true,
    "noImplicitOverride": true,
    "noImplicitReturns": true,
    "noFallthroughCasesInSwitch": true,
    "noUnusedLocals": true,
    "noUnusedParameters": true,
    "exactOptionalPropertyTypes": true,
    "forceConsistentCasingInFileNames": true,

    "skipLibCheck": true,
    "noEmit": true
  },
  "include": [
    "src",
    "drizzle.config.ts",
    "drizzle.journal.config.ts",
    "vitest.config.ts",
    "vitest.setup.ts",
    "vitest.db.config.ts",
    "vitest.db.setup.ts",
    "eslint.config.js"
  ]
}
