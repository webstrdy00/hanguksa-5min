# ---------------------------------------------------------------------------
# frontend 환경변수 예시. 실제 값은 .env.local 에 둔다.
#
# ⚠ VITE_ 로 시작하는 값은 번들에 그대로 들어간다.
#    secret, API 키, mTLS 인증서, DB 자격증명을 여기에 넣지 않는다. (공통 06 §3)
# ---------------------------------------------------------------------------

# backend API base URL. 로컬 개발 기본값은 backend 의 PORT 와 맞춘다.
VITE_API_BASE_URL=http://localhost:8080

# 콘솔 > 스마트발송에서 템플릿을 만든 뒤 코드를 넣는다.
# 비어 있으면 알림 동의 화면을 띄우지 않는다 (동의 없이 발송 0건).
VITE_NOTIFICATION_TEMPLATE_CODE=
