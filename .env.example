# ---------------------------------------------------------------------------
# 로컬 개발용 PostgreSQL (docker compose 전용)
# 실제 값은 .env 에 넣는다. .env 는 절대 커밋하지 않는다.
# staging / production 값은 이 파일이 아니라 Secret Manager에서 관리한다.
# ---------------------------------------------------------------------------
POSTGRES_USER=hanguksa
POSTGRES_PASSWORD=
POSTGRES_DB=hanguksa5min
# 로컬에 이미 PostgreSQL이 떠 있는 경우가 많아 5433을 기본값으로 둔다.
POSTGRES_PORT=5433
